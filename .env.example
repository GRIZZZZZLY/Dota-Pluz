# Ключи облачных моделей для d2bg. Скопируйте этот файл в .env рядом с ним и вставьте ключи после «=».
# .env не попадает в git. Без ключей приложение работает на локальных правилах.

# Jev (TypeSafe): ключ из https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# DeepSeek через ForgetAPI: ключ из https://platform.forgetapi.ru (начинается с fgt-)
FORGETAPI_API_KEY=
